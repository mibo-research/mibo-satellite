# Keep secrets outside Git. The runner preserves request bodies but never auth headers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
MIBOE_W0_EVIDENCE_ROOT=
MIBOE_BLIND_SALT=

# Presence markers are set by the protected GitHub Actions W0 environment.
# Do not set them to bypass human-governance or credential checks.
MIBOE_W0_PROTECTED_ENVIRONMENT=
MIBOE_W0_RUNNER_REQUIREMENTS=

MIBOE_OPENAI_BASE_URL=https://api.openai.com
