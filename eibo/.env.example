# Keep secrets outside Git. The runner preserves request bodies but never auth headers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
EIBO_W0_EVIDENCE_ROOT=
EIBO_BLIND_SALT=

# Presence markers are set by the protected GitHub Actions W0 environment.
# Do not set them to bypass human-governance or credential checks.
EIBO_W0_PROTECTED_ENVIRONMENT=
EIBO_W0_RUNNER_REQUIREMENTS=

EIBO_OPENAI_BASE_URL=https://api.openai.com
EIBO_ANTHROPIC_BASE_URL=https://api.anthropic.com
EIBO_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
EIBO_XAI_BASE_URL=https://api.x.ai
EIBO_PERPLEXITY_BASE_URL=https://api.perplexity.ai
