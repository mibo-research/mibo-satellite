{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MIBO-Education Frozen Battery",
  "type": "object",
  "required": ["battery_id", "version", "status", "approved", "expected_item_count", "items"],
  "properties": {
    "battery_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "approved": {"type": "boolean"},
    "expected_item_count": {"type": "integer", "minimum": 1},
    "items": {
      "maxItems": 70,
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stratum", "frozen", "prompt_ja", "prompt_sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^(E[1-7]-(0[1-9]|10)|[A-Z][A-Z0-9-]*)$"},
          "stratum": {"type": "string", "minLength": 1},
          "frozen": {"const": true},
          "prompt_ja": {"type": "string", "minLength": 1},
          "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
